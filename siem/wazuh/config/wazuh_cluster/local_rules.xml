<group name="hispalis,mcp,">
  <rule id="100100" level="3">
    <decoded_as>json</decoded_as>
    <location>/var/log/hispalis/audit.log</location>
    <description>Hispalis MCP: llamada a una tool auditada (tool=$(tool), rol=$(role)).</description>
    <group>mcp_audit,</group>
  </rule>

  <rule id="100101" level="10">
    <if_sid>100100</if_sid>
    <field name="success">false</field>
    <description>Hispalis MCP: acceso denegado a informacion restringida (tool=$(tool), rol=$(role)).</description>
    <group>access_denied,mcp_rbac,</group>
  </rule>

  <rule id="100102" level="12">
    <if_sid>100100</if_sid>
    <field name="event">shadow_server_detected</field>
    <description>Hispalis MCP: servidor MCP no gobernado detectado (shadow server: $(server)).</description>
    <group>shadow_mcp_server,mcp_governance,</group>
  </rule>
</group>
